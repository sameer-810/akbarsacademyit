# Environment Configuration
# Copy this file to .env.local and update with your actual values

# Google Analytics
VITE_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# API Endpoints (for future backend integration)
VITE_API_BASE_URL=https://api.akbarsacademy.com
VITE_API_KEY=your_api_key_here

# Google Maps Embed
VITE_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps?q=Akbar%27s%20Academy%2C%20Sector%20G%2C%20A-4%20Line%2C%20Shop%20No.06%2C%20Trombay%2C%20Cheeta%20Camp%20Rd%2C%20Mankhurd%2C%20Mumbai%2C%20Maharashtra%20400088&output=embed
# Contact Email (for form submissions)
VITE_CONTACT_EMAIL=info@akbarsacademy.com

# Enrollment form -> Google Sheet. Deploy an Apps Script web app and paste its /exec URL here.
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Private spreadsheet used by the Apps Script (reference only; do not show this link to visitors).
VITE_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/151P29ygXWEIRSZfTQDRkXpi7jqh6G2FhmmAbfPJFFEE/edit

# WhatsApp Business Number
VITE_WHATSAPP_NUMBER=919769073820

# Phone Number
VITE_PHONE_NUMBER=+91 9769073820

# Stripe (for payment integration)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key

# Email Service (SendGrid, Mailgun, etc.)
VITE_EMAIL_SERVICE_API_KEY=your_email_service_key

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/akbarsacademy
VITE_LINKEDIN_URL=https://linkedin.com/company/akbarsacademy
VITE_TWITTER_URL=https://twitter.com/akbarsacademy
VITE_YOUTUBE_URL=https://youtube.com/@akbarsacademy

# App Configuration
VITE_APP_NAME=Akbar's Academy
VITE_APP_URL=https://akbarsacademy.com
NODE_ENV=development
